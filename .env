# ============================================================================
# 로컬 개발 환경 변수
# ============================================================================

# SQLite 데이터베이스 파일 경로.
# PostgreSQL 로 전환할 경우:
#   DATABASE_URL="postgresql://user:password@localhost:5432/job_dashboard?schema=public"
# 로 바꾸고 prisma/schema.prisma 의 datasource.provider 를 "postgresql" 로 변경한다.
DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------------
# 알림 스케줄러
# ----------------------------------------------------------------------------
# 스케줄러 자동 시작 여부. 끄고 싶으면 "false".
SCHEDULER_ENABLED="true"

# 스케줄러 점검 주기 (cron 표현식, Asia/Seoul 기준). 기본: 매 분
SCHEDULER_CRON="* * * * *"

# Occurrence 롤링 생성 배치 주기 (cron 표현식). 기본: 매일 04:10
GENERATION_CRON="10 4 * * *"

# ----------------------------------------------------------------------------
# 이메일 어댑터
# ----------------------------------------------------------------------------
# "console" : 콘솔에 출력만 (로컬 개발 기본값, 설정 불필요)
# "file"    : .mail-outbox/ 디렉토리에 .eml 파일로 저장
# "smtp"    : 실제 SMTP 발송 (아래 SMTP_* 설정 필요)
EMAIL_TRANSPORT="console"

EMAIL_FROM="정기업무 대시보드 <no-reply@example.com>"

# EMAIL_TRANSPORT="smtp" 인 경우에만 사용
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
